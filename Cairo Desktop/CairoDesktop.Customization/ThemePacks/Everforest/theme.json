// Everforest: a green-based, comfortable dark palette (https://github.com/sainnhe/everforest).
{
  "name": "Everforest",
  "author": "Cairo Plus",
  "description": "Soft forest greens, floating taskbar with a centred task list",
  "baseTheme": "Default",
  "darkMode": true,

  "palette": {
    "background": "#2D353B",
    "surface":    "#343F44",
    "overlay":    "#3D484D",
    "border":     "#475258",
    "text":       "#D3C6AA",
    "subtext":    "#9DA9A0",
    "accent":     "#A7C080",
    "accentText": "#2D353B",
    "urgent":     "#E67E80",
  },

  "resources": { "MenuTopBorderBrush": "#DBBC7F" },

  "font": { "family": "Segoe UI", "size": 12 },
  "wallpaper": { "file": "wallpaper.jpg", "style": "fill" },

  "menuBar": { "opacity": 0.96 },
  "taskbar": {
    "floating": true,
    "margin": 6,
    "cornerRadius": 10,
    "layout": { "left": ["desktopButton"], "center": ["tasks"], "right": ["quickLaunch", "taskList"] },
  },
  "animations": { "enabled": true, "durationMs": 220 },
}
