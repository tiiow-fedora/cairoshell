<UserControl x:Class="CairoDesktop.Customization.Settings.ThemePacksPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <!-- Lives inside Cairo's settings window, so it inherits that window's implicit TextBlock/CheckBox/Button styles. -->
    <StackPanel Orientation="Vertical" Width="460" HorizontalAlignment="Left">
        <CheckBox Name="chkEnabled" Click="chkEnabled_Click">
            <Label Content="Enable Cairo Plus customization" />
        </CheckBox>
        <TextBlock TextWrapping="Wrap" Foreground="#99e9ecf4" Margin="5,0,5,4">
            Theme packs restyle the menu bar, taskbar, icons, fonts, wallpaper and colours together.
            While a pack is active it replaces the theme chosen on the General tab.
        </TextBlock>

        <TextBlock Text="Theme packs" Style="{DynamicResource SettingGroupHeader}" />
        <ListBox Name="lstPacks"
                 Height="230"
                 Margin="5,4"
                 Background="#ff111111"
                 BorderBrush="#ff444444"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="lstPacks_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#ffe9ecf4" Margin="2,0" MinWidth="0" />
                                <TextBlock Text="(active)" Foreground="#ff6fcf97" Margin="2,0" MinWidth="0"
                                           Visibility="{Binding ActiveVisibility}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Subtitle}" Foreground="#99e9ecf4" Margin="2,0" MinWidth="0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Error}" Foreground="#ffff7b72" Margin="2,0" MinWidth="0" TextWrapping="Wrap"
                                       Visibility="{Binding ErrorVisibility}" />
                        </StackPanel>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Swatches}" Width="Auto" VerticalAlignment="Center">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="14" Height="14" Margin="1,0" CornerRadius="3"
                                            Background="{Binding}" BorderBrush="#40ffffff" BorderThickness="1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" Margin="5,4">
            <Button Name="btnApply" Click="btnApply_Click" Height="24" Padding="10,0" Margin="0,0,6,0">Apply theme</Button>
            <Button Click="btnReload_Click" Height="24" Padding="10,0" Margin="0,0,6,0">Reload</Button>
            <Button Click="btnOpenConfig_Click" Height="24" Padding="10,0" Margin="0,0,6,0">Open config file</Button>
            <Button Click="btnOpenPacks_Click" Height="24" Padding="10,0">Open theme packs folder</Button>
        </StackPanel>

        <TextBlock Text="Status" Style="{DynamicResource SettingGroupHeader}" />
        <TextBlock Name="txtStatus" TextWrapping="Wrap" Margin="5,0,5,8" />
    </StackPanel>
</UserControl>
